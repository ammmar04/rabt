# Copy to .env.local for local development. None of these are required to run
# locally — without them the app uses a throwaway database on your machine and
# saves photos into public/uploads.

# --- Required in production -------------------------------------------------

# Password for the /admin portal. Without this, admin stays LOCKED in production.
ADMIN_PASSWORD=

# Neon Postgres connection string.
# Vercel → Storage → Neon adds this to the project automatically.
DATABASE_URL=

# Vercel Blob token, for item photos.
# Vercel → Storage → Blob adds this to the project automatically.
BLOB_READ_WRITE_TOKEN=

# --- Optional ---------------------------------------------------------------

# Signs the admin session cookie. Defaults to a value derived from
# ADMIN_PASSWORD; set your own to keep sessions valid across password changes.
AUTH_SECRET=
